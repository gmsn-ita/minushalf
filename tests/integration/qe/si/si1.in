&CONTROL
  calculation = 'scf',
  outdir = '.'
  pseudo_dir = '.'
  verbosity = 'high'
/

&SYSTEM
  ibrav =  2,
  celldm(1) = 10.2076,
  nat =  2,
  ntyp = 1,
  ecutwfc = 50,
  nbnd = 8
/

&ELECTRONS
/

ATOMIC_SPECIES
  Si 28.086 Si.UPF

ATOMIC_POSITIONS (alat)
  Si 0.0 0.0 0.0
  Si 0.25 0.25 0.25

K_POINTS (automatic)
  8 8 8 0 0 0

