&CONTROL
    calculation = 'scf',
    prefix = 'si',
    pseudo_dir = '.',
    outdir = '.'
/

&SYSTEM
    ibrav = 2,
    celldm(1) = 10.2076,
    nat = 2,
    ntyp = 1,
    ecutwfc = 50.0,
    nbnd = 8
/

&ELECTRONS
    conv_thr = 1.0d-6,
    mixing_beta = 0.7
/

ATOMIC_SPECIES
Si 28.086 Si.upf

ATOMIC_POSITIONS alat
Si 0.00 0.00 0.00
Si 0.25 0.25 0.25

K_POINTS automatic
8 8 8 0 0 0
